</exclusion_atom_values>

# === OUTPUT FORMAT (STRICT JSON, no markdown fences) ===

{
  "rationale": "<3-5 sentences in clinical-reviewer voice; lead with chart fact, name criterion, cite evidence>",
  "key_points": [
    "<one decisive criterion + its chart-grounding, ≤20 words>",
    "<second decisive criterion + its chart-grounding, ≤20 words>",
    "<at most 1-2 more if needed>"
  ]
}
