<variableaddition>
;; --- new declarations (leave header only if none) ------------------
;; Bool   → JSON {"attr","entity","true","false","src"}
;; Numeric→ JSON {"attr","entity","unit","src"}
;; Enum   → each constructor on its own line + JSON {"attr","entity","true","src"}

;; example Bool
(declare-const has_ascites Bool) ; {"attr":"ascites","entity":"patient","true":"patient HAS ascites","false":"patient does NOT have ascites","src":"ascites present"}

;; example numeric
(declare-const albumin Real) ; {"attr":"albumin","entity":"patient","unit":"g/dL","src":"Albumin ≥ 3 g/dL"}

;; example enum (one constructor per line, each with JSON)
(declare-datatypes ()
  ((histology
     squamous_cell_bladder  ; {"attr":"histology","entity":"patient","true":"patient's histology is squamous cell bladder","src":"squamous cell bladder carcinoma"}
     adenocarcinoma_bladder ; {"attr":"histology","entity":"patient","true":"patient's histology is adenocarcinoma bladder","src":"adenocarcinoma of bladder"})))
</variableaddition>


