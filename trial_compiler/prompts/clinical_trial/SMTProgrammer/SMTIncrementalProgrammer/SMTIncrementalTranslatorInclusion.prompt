    "span": "adenocarcinoma of the esophagus",
    "variable_name": "patient_has_finding_of_adenocarcinoma_of_esophagus_now",
    "variable_meaning": "Boolean clinical finding indicating the patient currently has adenocarcinoma of the esophagus."
  },
  {
