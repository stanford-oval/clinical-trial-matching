JSON array:
[
  {
    "disease": "...",
    "conceptId": "...",
    "preferred_term": "...",
    "fully_specified_name": "...",
    "type": "...",
    "definition": "...",
    "best_match_term": "...",
    "CANDIDATE_IS_IDENTICAL_TO_DISEASE": "YES | NO",
    "CANDIDATE_IS_GENERAL_TO_DISEASE": "YES | NO",
    "CANDIDATE_RELATIONSHIP_TO_DISEASE": "IDENTICAL" | "ANCESTOR" | "OTHER",
    "decision": "KEEP|REJECT",
    "why": "≤20 words if REJECT else empty"
  },
  ...
]