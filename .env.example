# SatIR Environment Variables
# ===========================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Then source it before running:
#   source .env

# ── Azure OpenAI API ─────────────────────────────────────────────────────
# Primary endpoint (gpt-4.1 for most pipeline stages)
export OPENAI_ENDPOINT="https://YOUR-RESOURCE.openai.azure.com/openai/deployments/gpt-4.1"
export OPENAI_API_KEY="<your-api-key>"
export AZURE_OPENAI_API_KEY="$OPENAI_API_KEY"
export OPENAI_MODEL="gpt-4.1"

# Secondary endpoint (gpt-5 for IR finalizer/repair pipeline only)
export OPENAI_ENDPOINT_GPT5="https://YOUR-RESOURCE.openai.azure.com/openai/deployments/gpt-5"

# ── External Services ────────────────────────────────────────────────────
# SNOMED-CT Snowstorm terminology server (see QUICKSTART.md for setup)
# export SNOWSTORM_BASE="http://localhost:8080"
# export SNOWSTORM_BRANCH="MAIN"

# Elasticsearch (for vector-based concept search)
# export ELASTICSEARCH_URL="http://localhost:9200"

# ── Paths (optional — defaults in satir.toml) ───────────────────────────
# export SATIR_BUILD="./build"
# export TRIAL_DATA="./dataset/clinical_trial"
# export PN_DATA="./dataset/patient_notes"

# ── API Keys (optional) ─────────────────────────────────────────────────
# UMLS API key (for medical concept definitions in entity canonicalization)
export UMLS_API_KEY="<your-umls-key>"
